QSVTRows.real_qsvt_row_even
     : forall (H HR HL : hermitian.CanonicalHermitianSpace.type)
         (U : quantum.GisoLf.type H H) (JR : quantum.IsoLf.type HR H)
         (JL : quantum.IsoLf.type HL H) (d : nat)
         (phi : nat -> reals.Real.sort hermitian.R.body),
       ssrnat.odd d = false ->
       QSVTModel.poly_real (snd (QSVTModel.scalar_pair d phi d)) =
       nmodule.Algebra.zero ->
       hermitian.forward_comp
         (U:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
               HR)
         (V:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
               H)
         (W:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
               H)
         (hermitian.adj_lfun.body
            (QSVTModel.success_operator U JR JL d phi d))
         (quantum.IsoLf.sort JR) =
       hermitian.forward_comp
         (U:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
               HR)
         (V:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
               HR)
         (W:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
               H)
         (quantum.IsoLf.sort JR)
         (hermitian.adj_lfun.body
            (QSVTModel.sv_even (H:=HR) (K:=HL)
               (QSVTModel.poly_real (fst (QSVTModel.scalar_pair d phi d)))
               (QSVTModel.encoded U JR JL)))
