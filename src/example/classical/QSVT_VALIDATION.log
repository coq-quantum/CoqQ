QSVTWords.qsvt_prefix_adjoint_odd
     : forall (H HR HL : hermitian.CanonicalHermitianSpace.type)
         (U : quantum.GisoLf.type H H) (JR : quantum.IsoLf.type HR H)
         (JL : quantum.IsoLf.type HL H) (d : nat)
         (phi : nat -> reals.Real.sort hermitian.R.body),
       ssrnat.odd d = true ->
       hermitian.adj_lfun.body
         (quantum.GisoLf.sort (QSVTModel.qsvt_prefix U JR JL d phi d)) =
       quantum.GisoLf.sort
         (QSVTModel.qsvt_prefix
            (quantum.GisoLf.phant_clone
               (cT:=quantum.adj_lfun_body__canonical__quantum_GisoLf U)
               (c:={|
                     quantum.GisoLf.quantum_isBound1Lf_mixin :=
                       quantum.HB_unnamed_factory_319
                         (quantum.GisoLf.Exports.quantum_GisoLf__to__quantum_Bound1Lf
                            U);
                     quantum.GisoLf.quantum_Bound1_isIsoLf_mixin :=
                       quantum.HB_unnamed_factory_431 U;
                     quantum.GisoLf.quantum_Iso_isGisoLf_mixin :=
                       quantum.HB_unnamed_factory_434 U
                   |})
               structures.id_phant structures.id_phant)
            JL JR d
            (fun j : nat => nmodule.Algebra.opp (phi (ssrnat.subn d j))) d)
