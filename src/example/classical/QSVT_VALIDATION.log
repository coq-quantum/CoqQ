QSVTSVD.sv_even_svd
     : forall (H K : hermitian.CanonicalHermitianSpace.type)
         (A : hermitian.forward_hom
                (hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                   H)
                (hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                   K))
         (p : poly.polynomial hermitian.C),
       QSVTPolynomial.poly_parity (R:=hermitian.R.body) p false ->
       hermitian.h2mx.body (QSVTModel.sv_even (H:=H) (K:=K) p A) =
       matrix.mulmx
         (matrix.mulmx
            (svd.svd_v
               (R:=complex.complex_complex__canonical__Num_ClosedField
                     (reals.Real.Exports.reals_Real__to__Num_RealClosedField
                        hermitian.R.body))
               (hermitian.h2mx.body A))
            (matrix.diag_mx
               (matrix.matrix_of_fun.body matrix.matrix_key
                  (fun (_ : fintype.ordinal 1)
                     (j : fintype.ordinal
                            (vector.dim
                               (hermitian.CanonicalHermitianSpace.sort H))) =>
                   poly.horner p
                     (matrix.fun_of_matrix
                        (svd.svd_d_exdr
                           (R:=complex.complex_complex__canonical__Num_ClosedField
                                 (reals.Real.Exports.reals_Real__to__Num_RealClosedField
                                    hermitian.R.body))
                           (p:=vector.dim
                                 (vector.Vector.Exports.vector_Vector__to__vector_SemiVector
                                    (hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_Vector
                                       K)))
                           (q:=vector.dim
                                 (hermitian.CanonicalHermitianSpace.sort H))
                           (svd.svd_d
                              (R:=complex.complex_complex__canonical__Num_ClosedField
                                    (reals.Real.Exports.reals_Real__to__Num_RealClosedField
                                       hermitian.R.body))
                              (hermitian.h2mx.body A)))
                        nmodule.Algebra.zero j)))))
         (mxpred.adjmx
            (R:=complex.complex_complex__canonical__Num_ClosedField
                  (reals.Real.Exports.reals_Real__to__Num_RealClosedField
                     hermitian.R.body))
            (svd.svd_v
               (R:=complex.complex_complex__canonical__Num_ClosedField
                     (reals.Real.Exports.reals_Real__to__Num_RealClosedField
                        hermitian.R.body))
               (hermitian.h2mx.body A)))
