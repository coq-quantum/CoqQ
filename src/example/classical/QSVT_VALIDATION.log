QSVTPolynomialCorrectness.even_preE
     : forall (T : qreg.qType) (qr : qreg.wf_qreg (qreg.QPair qreg.QBool T))
         (HR HL : hermitian.CanonicalHermitianSpace.type)
         (U : quantum.GisoLf.type
                (inhabited.ihb_chsType.body (qreg.eval_qtype T))
                (inhabited.ihb_chsType.body (qreg.eval_qtype T)))
         (JR : quantum.IsoLf.type HR
                 (inhabited.ihb_chsType.body (qreg.eval_qtype T)))
         (JL : quantum.IsoLf.type HL
                 (inhabited.ihb_chsType.body (qreg.eval_qtype T)))
         (d : nat) (phi : nat -> reals.Real.sort hermitian.R.body)
         (p : poly.polynomial hermitian.C)
         (Hp : QSVTModel.poly_real (fst (QSVTModel.scalar_pair d phi d)) = p)
         (Hq0 : QSVTModel.poly_real (snd (QSVTModel.scalar_pair d phi d)) =
                nmodule.Algebra.zero)
         (x : language.ClassicalLanguage.variable
                language.ClassicalLanguage.Integer)
         (y : language.ClassicalLanguage.variable (qreg.QType qreg.QBool))
         (Hd : ssrnat.odd d = false) (E : quantum.ObsLf.type HR)
         (s : choice.Choice.sort qreg.cmem),
       quantum.ObsLf.sort
         (hoare.CQHoare.pre true
            (QSVTPolynomialCorrectness.polynomial_command qr U JR JL d phi x
               y)
            (QSVTPolynomialCorrectness.even_post qr JR d x y E) s) =
       quantum.ObsLf.sort
         (QSVTPolynomialCorrectness.even_pre qr U JR JL (d:=d) (phi:=phi) Hp
            Hq0 Hd E s)
