AncillaHeralding.register_success_kraus
     : forall (T : qreg.qType) (qr : qreg.wf_qreg (qreg.QPair qreg.QBool T))
         (V : bool ->
              quantum.GisoLf.type
                (inhabited.ihb_chsType.body (qreg.eval_qtype T))
                (inhabited.ihb_chsType.body (qreg.eval_qtype T))),
       AncillaHeralding.success_channel qr V =
       quantum.krausso.body
         (U:=hstensor.Hs.body
               (I:=qmem.QMemory.mem_label
                     qmem.DefaultQMem.Exports.default_qmemory.body)
               (qmem.QMemory.mem_system
                  (q:=qmem.DefaultQMem.Exports.default_qmemory.body))
               (finset.setTfor
                  (qmem.QMemory.mem_label
                     qmem.DefaultQMem.Exports.default_qmemory.body)))
         (V:=hstensor.Hs.body
               (I:=qmem.QMemory.mem_label
                     qmem.DefaultQMem.Exports.default_qmemory.body)
               (qmem.QMemory.mem_system
                  (q:=qmem.DefaultQMem.Exports.default_qmemory.body))
               (finset.setTfor
                  (qmem.QMemory.mem_label
                     qmem.DefaultQMem.Exports.default_qmemory.body)))
         (F:=fintype.Datatypes_bool__canonical__fintype_Finite)
         (fun i : bool =>
          hstensor.liftf_lf
            (H:=qmem.QMemory.mem_system
                  (q:=qmem.DefaultQMem.Exports.default_qmemory.body))
            (S:=qmem.QMemory.qreg_set
                  qmem.DefaultQMem.Exports.default_qmemory.body
                  (qreg.qreg_base qr))
            (qmem.QMemory.tf2f.body
               qmem.DefaultQMem.Exports.default_qmemory.body
               (qreg.qreg_base qr) (qreg.qreg_base qr)
               (inhabited.tentf
                  (S1:=inhabited.Datatypes_bool__canonical__inhabited_FinInhabited)
                  (S2:=qreg.eval_qtype T)
                  (T1:=inhabited.Datatypes_bool__canonical__inhabited_FinInhabited)
                  (T2:=qreg.eval_qtype T)
                  (hermitian.outp.body (inhabited.t2tv false)
                     (inhabited.t2tv i))
                  (quantum.Bound1Lf.sort
                     (AncillaHeralding.symmetric_circuit V)))))
