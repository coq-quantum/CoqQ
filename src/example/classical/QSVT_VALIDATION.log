QSVTNormCompleteness.symmetric_antisymmetric_complete
     : forall (T : inhabited.FinInhabited.type)
         (V : bool ->
              quantum.GisoLf.type (inhabited.ihb_chsType.body T)
                (inhabited.ihb_chsType.body T)),
       nmodule.Algebra.add
         (hermitian.forward_comp
            (U:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                  (inhabited.ihb_chsType.body T))
            (V:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                  (inhabited.ihb_chsType.body T))
            (W:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                  (inhabited.ihb_chsType.body T))
            (hermitian.adj_lfun.body
               (quantum.Bound1Lf.sort (AncillaHeralding.symmetric_circuit V)))
            (quantum.Bound1Lf.sort (AncillaHeralding.symmetric_circuit V)))
         (hermitian.forward_comp
            (U:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                  (inhabited.ihb_chsType.body T))
            (V:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                  (inhabited.ihb_chsType.body T))
            (W:=hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
                  (inhabited.ihb_chsType.body T))
            (hermitian.adj_lfun.body
               (quantum.Bound1Lf.sort
                  (QSVTFailureSemantics.antisymmetric_circuit V)))
            (quantum.Bound1Lf.sort
               (QSVTFailureSemantics.antisymmetric_circuit V))) =
       hermitian.forward_id
         (hermitian.CanonicalHermitianSpace.Exports.hermitian_CanonicalHermitianSpace__to__vector_SemiVector
            (inhabited.ihb_chsType.body T))
