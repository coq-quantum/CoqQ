QSVTRealPair.real_qsp_phase_witness
     : forall (R : reals.Real.type) (d : nat)
         (p : poly.polynomial
                (reals.Real.Exports.reals_Real__to__GRing_NzSemiRing R)),
       QSVTRealPair.admissible (R:=R) d p ->
       exists (prefix : list (reals.Real.sort R)) 
       (last : reals.Real.sort R),
         seq.size prefix = d /\
         nmodule.Algebra.add
           (fst (QSVTPolynomial.qsp_pair (R:=R) prefix last))
           (QSVTPolynomial.poly_star (R:=R)
              (fst (QSVTPolynomial.qsp_pair (R:=R) prefix last))) =
         rings_modules_and_algebras.GRing.scale
           (nmodule.Algebra.natmul
              (V:=rings_modules_and_algebras.GRing.PzSemiRing.Exports.GRing_PzSemiRing__to__Algebra_BaseAddUMagma
                    (rings_modules_and_algebras.GRing.NzSemiRing.Exports.GRing_NzSemiRing__to__GRing_PzSemiRing
                       (complex.ComplexField.complex_complex__canonical__GRing_NzSemiRing
                          (reals.Real.Exports.reals_Real__to__GRing_Field R))))
              (rings_modules_and_algebras.GRing.one
                 (rings_modules_and_algebras.GRing.NzSemiRing.Exports.GRing_NzSemiRing__to__GRing_PzSemiRing
                    (complex.ComplexField.complex_complex__canonical__GRing_NzSemiRing
                       (reals.Real.Exports.reals_Real__to__GRing_Field R))))
              2)
           (QSVTRealPair.r_embed (R:=R) p) /\
         nmodule.Algebra.add
           (snd (QSVTPolynomial.qsp_pair (R:=R) prefix last))
           (QSVTPolynomial.poly_star (R:=R)
              (snd (QSVTPolynomial.qsp_pair (R:=R) prefix last))) =
         nmodule.Algebra.zero
