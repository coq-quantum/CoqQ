QSVTExamples.qsp_example_degree_zero
     : forall (R : reals.Real.type) (c : reals.Real.sort R),
       is_true
         (preorder.Order.le
            (nmodule.Algebra.opp
               (rings_modules_and_algebras.GRing.one
                  (rings_modules_and_algebras.GRing.PzRing.Exports.join_GRing_PzRing_between_Algebra_BaseZmodule_and_GRing_PzSemiRing
                     (numdomain.Num.NumDomain.Exports.join_Num_NumDomain_between_Num_POrderZmodule_and_GRing_PzRing
                        (reals.Real.Exports.reals_Real__to__Num_NumDomain R)))))
            c &&
          preorder.Order.le c
            (rings_modules_and_algebras.GRing.one
               (numdomain.Num.NumDomain.Exports.join_Num_NumDomain_between_Order_Preorder_and_GRing_PzSemiRing
                  (reals.Real.Exports.reals_Real__to__Num_NumDomain R)))) ->
       QSVTPolynomial.qsp_pair (R:=R) nil
         (trigonometry_functions.acos.body c) =
       (poly.polyC
          {|
            complex.Re := c;
            complex.Im :=
              numfield.Num.Def.sqrtr
                (nmodule.Algebra.add
                   (rings_modules_and_algebras.GRing.one
                      (rings_modules_and_algebras.GRing.PzRing.Exports.join_GRing_PzRing_between_Algebra_BaseZmodule_and_GRing_PzSemiRing
                         (reals.Real.Exports.reals_Real__to__GRing_PzRing R)))
                   (nmodule.Algebra.opp
                      (rings_modules_and_algebras.GRing.exp
                         (R:=reals.Real.Exports.reals_Real__to__GRing_PzSemiRing
                               R)
                         c 2)))
          |},
        nmodule.Algebra.zero)
